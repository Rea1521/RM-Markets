# Backend origin. Leave empty in dev (Vite proxies /api and /ws to localhost:8000)
VITE_API_URL=
# Optional: Google Sign-In client id (must match GOOGLE_CLIENT_ID on the backend)
VITE_GOOGLE_CLIENT_ID=
# Optional: CDN origin that serves /assets (e.g. Cloudflare in front of the web service)
VITE_CDN_URL=
