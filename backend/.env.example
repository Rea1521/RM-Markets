APP_ENV=development
# SQLite by default. Production: your Neon pooled connection string, e.g.
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./rm_markets.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Optional locally; required for multiple instances (Railway Redis plugin injects REDIS_URL)
REDIS_URL=
# REQUIRED in production: long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=*
# all | market | trading | analytics (comma separated) - which API groups this process serves
SERVICE_MODE=all
# exactly ONE process should run the live feed + order matcher
RUN_MARKET_FEED=true
# live | sim  (sim = offline simulated prices, used in tests)
MARKET_PROVIDER_MODE=live
STOCK_POLL_SECONDS=15
# Optional data providers
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
NEWSAPI_KEY=
# Optional Google Sign-In
GOOGLE_CLIENT_ID=
ALLOW_DEMO_LOGIN=true
# Trading rules
STARTING_BALANCE=100000
ENFORCE_MARKET_HOURS=false
DAILY_LOSS_LIMIT_PCT=0.20
MAX_POSITION_PCT=1.0
RATE_LIMIT_PER_MINUTE=240
